{
  "openapi": "3.1.0",
  "info": {
    "title": "Weft v2",
    "version": "2.0.0",
    "description": "Weft v2 HTTP 契约。本文件是协议的唯一依据。"
  },
  "paths": {
    "/api/v2/service": {
      "get": {
        "operationId": "getService",
        "summary": "查询服务信息",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "当前进程的服务信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "4XX": {
            "description": "客户端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "5XX": {
            "description": "服务端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/service/restart": {
      "post": {
        "operationId": "restartService",
        "summary": "请求服务退出，由客户端重新拉起",
        "description": "服务只负责退出当前进程，不负责再拉起。客户端在收到 202 后自行启动新进程。\n任务图里还有活着的任务（含后台子 Agent）时返回 409，避免打断正在跑的工作。\n",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "202": {
            "description": "已接受，服务即将退出。重新拉起由客户端完成。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestartAccepted"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "409": {
            "description": "有活着的任务，此时不能退出",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "4XX": {
            "description": "客户端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "5XX": {
            "description": "服务端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/auth/web-code": {
      "post": {
        "operationId": "createWebCode",
        "summary": "用本机令牌签发一次性网页登录码",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "一次性登录码",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebCode"
                }
              }
            }
          },
          "400": {
            "description": "请求体不是 JSON 对象",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "401": {
            "description": "未授权（仅接受 Bearer 本机令牌）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "413": {
            "description": "请求体过大",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "4XX": {
            "description": "客户端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "5XX": {
            "description": "服务端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "发现文件里的本机令牌"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "weft_session",
        "description": "网页端一次性码换来的会话 cookie"
      }
    },
    "schemas": {
      "ServiceInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "serviceVersion",
          "pid",
          "startedAt"
        ],
        "properties": {
          "protocolVersion": {
            "type": "string"
          },
          "serviceVersion": {
            "type": "string"
          },
          "pid": {
            "type": "integer"
          },
          "startedAt": {
            "type": "integer",
            "description": "进程启动时间（毫秒时间戳）"
          }
        }
      },
      "RestartAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exiting"
        ],
        "properties": {
          "exiting": {
            "type": "boolean",
            "description": "始终为 true。服务即将退出，由客户端重新拉起。"
          }
        }
      },
      "ServiceDiscovery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "serviceVersion",
          "pid",
          "port",
          "startedAt",
          "token"
        ],
        "properties": {
          "protocolVersion": {
            "type": "string"
          },
          "serviceVersion": {
            "type": "string"
          },
          "pid": {
            "type": "integer"
          },
          "port": {
            "type": "integer",
            "description": "服务实际监听的端口"
          },
          "startedAt": {
            "type": "integer",
            "description": "进程启动时间（毫秒时间戳）"
          },
          "token": {
            "type": "string",
            "description": "本机令牌。只存在内存和本文件，服务每次启动轮换"
          }
        },
        "description": "数据目录里的发现文件 `<dataDir>/service.json`，不对应 HTTP 接口。"
      },
      "WebCode": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "expiresAt"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer",
            "description": "过期时间（毫秒时间戳）"
          }
        }
      },
      "V2Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Device": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "platform",
          "createdAt",
          "lastSeenAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer",
            "description": "创建时间（毫秒时间戳）"
          },
          "lastSeenAt": {
            "type": "integer",
            "description": "最近出现时间（毫秒时间戳）"
          }
        },
        "description": "远程设备。契约先定义形状，实现以后再做。"
      },
      "PairingRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "deviceName",
          "platform"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "deviceName": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          }
        },
        "description": "设备配对请求。契约先定义形状，实现以后再做。"
      }
    }
  }
}
