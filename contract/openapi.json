{
  "openapi": "3.1.0",
  "info": {
    "title": "Weft v2",
    "version": "2.0.0",
    "description": "Weft v2 HTTP 契约。本文件是协议的唯一依据。"
  },
  "paths": {
    "/api/v2/service": {
      "get": {
        "operationId": "getService",
        "summary": "查询服务信息",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "当前进程的服务信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "4XX": {
            "description": "客户端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "5XX": {
            "description": "服务端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/service/restart": {
      "post": {
        "operationId": "restartService",
        "summary": "请求服务退出，由客户端重新拉起",
        "description": "服务只负责退出当前进程，不负责再拉起。客户端在收到 202 后自行启动新进程。\n任务图里还有活着的任务（含后台子 Agent）时返回 409，避免打断正在跑的工作。\n",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "202": {
            "description": "已接受，服务即将退出。重新拉起由客户端完成。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestartAccepted"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "409": {
            "description": "有活着的任务，此时不能退出",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "4XX": {
            "description": "客户端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "5XX": {
            "description": "服务端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/auth/web-code": {
      "post": {
        "operationId": "createWebCode",
        "summary": "用本机令牌签发一次性网页登录码",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "一次性登录码",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebCode"
                }
              }
            }
          },
          "400": {
            "description": "请求体不是 JSON 对象",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "401": {
            "description": "未授权（仅接受 Bearer 本机令牌）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "413": {
            "description": "请求体过大",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "4XX": {
            "description": "客户端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "5XX": {
            "description": "服务端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/events": {
      "get": {
        "operationId": "getEvents",
        "summary": "SSE 推送流",
        "description": "一个客户端一条 SSE 连接，用查询参数 `topics` 订阅主题（逗号分隔），`lang` 为 zh 或 en（缺省 zh，不认识的按 zh）。\n每条业务事件带全局递增序号，写成标准 SSE：`id: <序号>`、`event: <类型>`、`data: <JSON>`。\n断线后带 `Last-Event-ID` 头（或查询参数 `lastEventId`）续传；环形缓冲里补不上（太旧、比当前还新、或格式不对）时先发一份新快照。\n没带 Last-Event-ID 时先发快照。快照的 SSE id 是当时的最新序号。\n订阅的主题和上次不同时，客户端不要带 Last-Event-ID / lastEventId，直接重新连接拿快照（续传只保证同一组主题）。\n心跳每 15 秒一次，不带 id，不进缓冲。\n\n事件名与 data 的对应关系：\n- `snapshot` → SnapshotEvent\n- `upsert` → UpsertEvent\n- `remove` → RemoveEvent\n- `text.delta` → TextDeltaEvent\n- `heartbeat` → HeartbeatEvent\n",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "topics",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "逗号分隔的主题列表。空或含未注册主题时 400。"
          },
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "zh"
            },
            "description": "客户端语言。先支持 zh、en；缺省或不认识的按 zh。"
          },
          {
            "name": "lastEventId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "给不方便设 Last-Event-ID 头的客户端。与 Last-Event-ID 头效果相同。"
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "上次收到的事件序号。缓冲里还有它之后的全部事件则按主题过滤补发，否则发快照。"
          }
        ],
        "responses": {
          "200": {
            "description": "SSE 事件流",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "标准 SSE 文本。每条事件的 data 为对应 schema 的 JSON。"
                }
              }
            }
          },
          "400": {
            "description": "主题列表为空或含未注册主题",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "4XX": {
            "description": "客户端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          },
          "5XX": {
            "description": "服务端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "发现文件里的本机令牌"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "weft_session",
        "description": "网页端一次性码换来的会话 cookie"
      }
    },
    "schemas": {
      "ServiceInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "serviceVersion",
          "pid",
          "startedAt"
        ],
        "properties": {
          "protocolVersion": {
            "type": "string"
          },
          "serviceVersion": {
            "type": "string"
          },
          "pid": {
            "type": "integer"
          },
          "startedAt": {
            "type": "integer",
            "description": "进程启动时间（毫秒时间戳）"
          }
        }
      },
      "RestartAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exiting"
        ],
        "properties": {
          "exiting": {
            "type": "boolean",
            "description": "始终为 true。服务即将退出，由客户端重新拉起。"
          }
        }
      },
      "ServiceDiscovery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "serviceVersion",
          "pid",
          "port",
          "startedAt",
          "token"
        ],
        "properties": {
          "protocolVersion": {
            "type": "string"
          },
          "serviceVersion": {
            "type": "string"
          },
          "pid": {
            "type": "integer"
          },
          "port": {
            "type": "integer",
            "description": "服务实际监听的端口"
          },
          "startedAt": {
            "type": "integer",
            "description": "进程启动时间（毫秒时间戳）"
          },
          "token": {
            "type": "string",
            "description": "本机令牌。只存在内存和本文件，服务每次启动轮换"
          }
        },
        "description": "数据目录里的发现文件 `<dataDir>/service.json`，不对应 HTTP 接口。"
      },
      "WebCode": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "expiresAt"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer",
            "description": "过期时间（毫秒时间戳）"
          }
        }
      },
      "V2Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Device": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "platform",
          "createdAt",
          "lastSeenAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer",
            "description": "创建时间（毫秒时间戳）"
          },
          "lastSeenAt": {
            "type": "integer",
            "description": "最近出现时间（毫秒时间戳）"
          }
        },
        "description": "远程设备。契约先定义形状，实现以后再做。"
      },
      "PairingRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "deviceName",
          "platform"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "deviceName": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          }
        },
        "description": "设备配对请求。契约先定义形状，实现以后再做。"
      },
      "EntityRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "entity",
          "id",
          "value"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "value": {
            "type": "object",
            "additionalProperties": true,
            "description": "各主题的实体类型以后各自定义"
          }
        },
        "description": "快照里的一条实体。SSE event=snapshot 的 entities 项。"
      },
      "SnapshotEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "topics",
          "entities"
        ],
        "properties": {
          "protocolVersion": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityRef"
            }
          }
        },
        "description": "SSE event=snapshot 的 data。连接时或续传补不上时发送；SSE id 为当时最新序号。"
      },
      "UpsertEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "entity",
          "id",
          "value"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "value": {
            "type": "object",
            "additionalProperties": true,
            "description": "各主题的实体类型以后各自定义"
          }
        },
        "description": "SSE event=upsert 的 data。实体整个替换，客户端按 id 覆盖。"
      },
      "RemoveEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "entity",
          "id"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "description": "SSE event=remove 的 data。实体删除。"
      },
      "TextDeltaEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "itemId",
          "offset",
          "append"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "itemId": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "append": {
            "type": "string"
          }
        },
        "description": "SSE event=text.delta 的 data。只用于流式文字。offset 对不上时客户端丢掉本地内容，等下一次 upsert。"
      },
      "HeartbeatEvent": {
        "type": "object",
        "additionalProperties": false,
        "description": "SSE event=heartbeat 的 data。不带 id，不进环形缓冲。"
      },
      "ToolCall": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "groupId",
          "kind",
          "status",
          "heading",
          "hint",
          "failure",
          "diff",
          "output"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "groupId": {
            "type": "string",
            "description": "所属工具组 id，由组内第一条调用算出"
          },
          "kind": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "edit",
              "ls",
              "grep",
              "bash",
              "other"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "failed",
              "interrupted",
              "done"
            ]
          },
          "heading": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "detail",
              "fromIntent"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "fromIntent": {
                "type": "boolean",
                "description": "title 是否来自 input.description"
              }
            }
          },
          "path": {
            "type": "string",
            "description": "相对工作区路径。没有则省略"
          },
          "hint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "failed"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "failed": {
                "type": "boolean"
              }
            }
          },
          "failure": {
            "type": "string",
            "enum": [
              "none",
              "probe",
              "real"
            ]
          },
          "diff": {
            "description": "没有增删行数时为 null",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "added",
                  "removed"
                ],
                "properties": {
                  "added": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "removed": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            ]
          },
          "exitCode": {
            "type": "integer",
            "description": "bash 有退出码时带上，否则省略"
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "preview",
              "truncated",
              "totalLines"
            ],
            "properties": {
              "preview": {
                "type": "string",
                "description": "成功取前 20 行，失败取 TOOL_ERROR_PREVIEW_LINES 行"
              },
              "truncated": {
                "type": "boolean"
              },
              "totalLines": {
                "type": "integer"
              }
            }
          }
        },
        "description": "单条工具调用的视图模型。全文按需拉 GET /api/v2/tools/<id>/output。"
      },
      "ToolGroupSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "failed",
          "running"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "按客户端语言出成的摘要句子"
          },
          "failed": {
            "type": "integer",
            "description": "组内真实失败（不含试探失败）的条数"
          },
          "running": {
            "type": "boolean"
          }
        },
        "description": "工具组摘要。对应 ThreadItem.tool_group.summary。"
      },
      "PathRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "path"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "行内代码的原文"
          },
          "path": {
            "type": "string",
            "description": "相对工作区的路径（统一用 /）"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "来自行内代码里的 :行号 后缀"
          }
        },
        "description": "行内代码里在工作区中真实存在的文件路径。各端渲染 Markdown 时把这些变成可点的标签。"
      },
      "ContextUsage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "used",
          "window",
          "percent",
          "level"
        ],
        "properties": {
          "used": {
            "type": "integer",
            "minimum": 0,
            "description": "已占用的上下文 token 数。没有用量时为 0"
          },
          "window": {
            "type": "integer",
            "minimum": 1,
            "description": "上下文窗口大小"
          },
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "已用百分比，四舍五入，上限 100"
          },
          "level": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "full"
            ],
            "description": "percent < 80 为 ok，80 到 94 为 warn，≥ 95 为 full"
          }
        },
        "description": "上下文用量视图。窗口由调用方传入（手动覆盖 → Provider 默认 → 模型目录 → 环境变量）；缺省 128000。"
      }
    }
  }
}
